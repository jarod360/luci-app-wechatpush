#!/bin/sh /etc/rc.common

START=99
STOP=90
USE_PROCD=1

# A service may not be registered with procd when stop/uninstall runs.
# Suppress only service-delete errors; pass all other ubus calls through unchanged.
__UBUS_BIN="$(command -v ubus || echo /bin/ubus)"
ubus() {
    if [ "$1" = "call" ] && [ "$2" = "service" ] && [ "$3" = "delete" ]; then
        "$__UBUS_BIN" "$@" >/dev/null 2>&1 || true
    else
        "$__UBUS_BIN" "$@"
    fi
}

dir="/tmp/wechatpush/"

start_service() {
    procd_open_instance
    enable_value=$(uci get wechatpush.config.enable 2>/dev/null || echo "0")
    [ "$enable_value" -ne "0" ] && procd_set_param command /usr/share/wechatpush/wechatpush && echo "wechatpush is starting now ..."
    procd_close_instance
}

reload_service() {
    stop
    sleep 1
    start
}

stop_service() {
    [ -f ${dir}child_pid ] && parent_pid=$(cat ${dir}child_pid)
    [ -n "$parent_pid" ] && {
        child_pids=$(pgrep -P $parent_pid)
        echo "Terminating child processes of wechatpush..."
        for child_pid in $child_pids; do
            kill $child_pid
        done
    }
    # Do not kill processes by the generic name "wechatpush": this also matches
    # opkg's luci-app-wechatpush.prerm shell and can abort the uninstall itself.
    # procd handles the main service process; the child_pid block above handles
    # the detached log-monitor's children.
    echo "Stopping wechatpush service..."
}

service_triggers() {
    procd_add_reload_trigger wechatpush
}
